+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn notification_has_no_transaction_or_settlement_fields() {
+        for kind in [BEGIN, ROLLBACK_NOTICE, COMMIT_NOTICE] {
+            let mut p = Packet::new(kind);
