+                    1024,
+                    Instant::now() + Duration::from_secs(10),
+                )
+                .unwrap();
+            entries.push(Entry {
+                path: (*path).to_owned(),
+                bytes: bytes.len() as u32,
+                sha256,
+                component: format!("00000000-0000-0000-0000-{:012X}", i + 1),
+            });
+        }
+        owner.release().unwrap();
+        (
+            tree,
+            base,
+            Manifest {
