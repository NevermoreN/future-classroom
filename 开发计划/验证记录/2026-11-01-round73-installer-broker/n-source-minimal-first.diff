+        .iter()
+        .enumerate()
+        {
+            let bytes = format!("public effects fixture {i}\n").into_bytes();
+            let file = base.join(path);
+            fs::write(&file, &bytes).unwrap();
+            let file = fs::File::open(file).unwrap();
+            let sha256 = owner
+                .digest(
