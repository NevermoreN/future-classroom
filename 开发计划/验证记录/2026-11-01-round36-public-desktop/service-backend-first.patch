+            fixture.service.0.read_desktop_lesson(&next_guard),
+            Err(BackendError::Lesson(LessonRepositoryError::Domain(
+                fc_domain::lesson_context::LessonContextError::LessonContextChanged
+            )))
+        ));
+    }
