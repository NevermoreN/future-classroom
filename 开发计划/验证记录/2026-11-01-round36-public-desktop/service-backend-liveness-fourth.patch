     #[test]
+    fn public_desktop_single_liveness_check_survives_a_deterministic_updating_to_healthy_phase_flip(
+    ) {
+        let mut fixture = Fixture::new();
+        let owner = fixture.flow(1);
+        let guard = owner.guard();
+        let target = fixture
+            .service
+            .0
+            .read_desktop_lesson(&guard)
+            .unwrap()
+            .context
+            .current
+            .unwrap()
+            .base;
+        let control = fixture.service.0.session_control();
+        let checking = guard.clone();
+        let first_not_current = Arc::new(AtomicBool::new(false));
+        let sampled = first_not_current.clone();
+        {
+            let mut scope = fixture.service.0.begin_execution_scope(Arc::new(move || {
+                if control.health_gate().status().health
+                    == fc_runtime::health::Health::AuthorityUpdating
+                {
+                    sampled.store(!checking.is_current(), Ordering::Release);
+                    assert!(checking.can_keep_chooser_open());
+                }
+                true
+            }));
+            scope
+                .change_desktop_lesson(&guard, LessonAction::Replace(target))
+                .unwrap();
+        }
+        // The first old predicate was sampled in real Updating; this second
+        // old predicate is sampled after actual COMMIT/publication is Healthy.
+        // Combining those two negative answers would close a valid chooser.
+        assert!(first_not_current.load(Ordering::Acquire));
+        assert!(!guard.is_waiting_for_authority());
+        assert!(guard.is_current());
+        assert!(guard.can_keep_chooser_open());
+        owner.cancel();
+        assert!(!guard.can_keep_chooser_open());
+    }
