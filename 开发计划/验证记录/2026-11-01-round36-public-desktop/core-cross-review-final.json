  "conclusions": [
    {
      "topic": "Liveness is not submit or result authority",
      "locations": [
        "crates/fc-bootstrap/src/backend/desktop_lesson.rs:98",
        "crates/fc-bootstrap/src/backend/desktop_lesson.rs:104",
        "crates/fc-bootstrap/src/application.rs:3228",
        "crates/fc-bootstrap/src/application.rs:4180"
      ],
      "finding": "can_keep_chooser_open invokes the original interval_current(true) solely to retain UI during Healthy/AuthorityUpdating transitions. Event handler still returns without submission whenever Healthy-only is_current fails, even if liveness is true. Loaded-result acceptance and Backend entry/delivery still use is_current; no caller uses liveness to bind writer authority."
    },
    {
      "topic": "Single phase-agnostic UI liveness removes cross-sample false closure",
      "locations": [
        "crates/fc-bootstrap/src/application.rs:3229",
        "crates/fc-bootstrap/src/application.rs:3759",
        "crates/fc-bootstrap/src/backend/desktop_lesson_tests.rs:402"
      ],
      "finding": "Both automatic close sites now make one liveness decision accepting either allowed health phase, avoiding old !current sampled in Updating then !waiting sampled after Healthy. Existing is_waiting remains a busy-label predicate only. New regression source reproduces both old negative samples around a real transaction and checks liveness in both phases; it is not run by this review."
    },
    {
      "topic": "Original epoch/deadline/binding fences remain",
      "locations": [
        "crates/fc-bootstrap/src/backend/desktop_lesson.rs:120",
        "crates/fc-bootstrap/src/backend/desktop_lesson.rs:246",
        "crates/fc-bootstrap/src/backend/desktop_lesson.rs:342",
        "crates/fc-storage/src/business/desktop_lesson.rs:478"
      ],
      "finding": "interval_current body, exact active flow and epoch checks, monotonic rollback handling, original wall/Instant/tick deadlines, closed/recovery handling and private writer guard are unchanged. Foreground negative native callback and default-deny scoped repository/SQL exact binding/precommit rechecks are byte-identical to prior reviewed files. New liveness assertions reject original expiry and OS revocation."
    },
    {
      "topic": "Physical ownership and public scope unchanged",
      "locations": [
        "crates/fc-bootstrap/src/application.rs:3154",
        "crates/fc-bootstrap/src/application.rs:4004"
      ],
      "finding": "No change to close/cancel retaining Pending, late outcome consumption, unique non-Clone owner, exact rendered entry, honest LocalDesktop audit, original shared worker count or final physical shutdown. No account/session capability or Web/settings permission was added."
    }
  ],
