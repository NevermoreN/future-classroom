+    // credential KDFs and identity transactions; no SQLite/session fabrication.
+    submit(app, TO_SUBJECTS, &[], deadline)?;
+    submit(
+        app,
+        SAVE,
+        &[
+            (OLD_NAME, ""),
+            (SUBJECT, "Synthetic HTTPS subject"),
+            (COLOR, "123456"),
+        ],
+        deadline,
