+// Temporary R70 diagnostic: only the explicit hidden ordinary probe can emit
+// closed stage/class numbers. Never format an error, path, name or request value.
+#[derive(Clone, Copy)]
+#[repr(u8)]
+enum PreparationProbeStage {
+    Begin = 1,
+    Authority = 2,
+    Kind = 3,
+    Validate = 4,
+    Image = 5,
+    LengthAuthority = 6,
+    Resource = 7,
+    Directory = 8,
+    Publish = 9,
+    Complete = 10,
+    PdfHash = 11,
+    PdfHelper = 12,
+    PdfReport = 13,
+}
+fn preparation_probe(stage: PreparationProbeStage, class: u8, code: i32) {
+    if std::env::args_os().nth(1).as_deref() == Some(std::ffi::OsStr::new("--ordinary-https-probe"))
+    {
+        eprintln!(
+            "ORDINARY_MATERIAL_PREPARATION stage={} class={} code={}",
+            stage as u8, class, code
+        );
+    }
+}
+fn validation_probe_code(error: &fc_materials::validation::ValidationError) -> i32 {
+    use fc_materials::validation::ValidationError;
+    match error {
+        ValidationError::Io => 1,
+        ValidationError::InvalidName => 2,
+        ValidationError::UnsupportedType => 3,
+        ValidationError::InvalidText => 4,
+        ValidationError::InvalidImage => 5,
+        ValidationError::InvalidPdf => 6,
+        ValidationError::EncryptedPdf => 7,
+        ValidationError::ForbiddenContent => 8,
+        ValidationError::TooLarge => 9,
+        ValidationError::PdfRequiresHelper => 10,
+        ValidationError::Canceled => 11,
+        ValidationError::Deadline => 12,
+        ValidationError::CpuBudget => 13,
+        ValidationError::ClockUnavailable => 14,
+        ValidationError::Office(_) => 15,
+    }
+}
 fn io_error(_: impl std::fmt::Debug) -> io::Error {
     io::Error::other("controlled material file unavailable")
 }
