+#[test]
+fn failed_transaction_close_records_only_actual_committed_effect_and_retains_owner() {
+    const CHILD: &str = "FUTURE_CLASSROOM_TXR_TRANSACTION_CLOSE_CHILD";
+    let mode = std::env::var(CHILD).ok();
+    if mode.is_none() {
+        let name = std::thread::current().name().unwrap().to_owned();
+        for scenario in ["empty-disable", "committed-enable"] {
+            let mut child = std::process::Command::new(std::env::current_exe().unwrap())
+                .args(["--exact", &name, "--nocapture", "--test-threads=1"])
+                .env(CHILD, scenario)
+                .stdout(std::process::Stdio::piped())
+                .stderr(std::process::Stdio::piped())
+                .spawn()
+                .unwrap();
+            let deadline = Instant::now() + Duration::from_secs(15);
+            while child.try_wait().unwrap().is_none() {
+                if Instant::now() >= deadline {
+                    child.kill().unwrap();
+                    child.wait().unwrap();
+                    panic!("owned close-fault child exceeded its original 15s deadline");
+                }
+                std::thread::sleep(Duration::from_millis(1));
+            }
+            let output = child.wait_with_output().unwrap();
+            assert!(
+                output.status.success(),
+                "{scenario}: {}",
+                String::from_utf8_lossy(&output.stderr)
+            );
+            assert!(String::from_utf8_lossy(&output.stdout).contains("1 passed"));
+        }
+        return;
+    }
+    let enabled = match mode.as_deref() {
+        Some("empty-disable") => false,
+        Some("committed-enable") => true,
+        _ => panic!("unknown owned synthetic child scenario"),
+    };
+    let scratch = Scratch::new();
+    let mut run = scratch.run();
+    run.fail_transaction_close = true;
+    let outcome = run.apply(&AutostartObservation::Absent, enabled, &|| true);
+    assert_eq!(outcome.failure, Some(AutostartFailure::Interrupted));
+    assert_eq!(
+        outcome.observation,
+        AutostartObservation::Unavailable(AutostartFailure::Interrupted)
+    );
+    // Both transactions really committed. Only enable staged a successful value
+    // mutation; an empty disable commit must not invent a changed Run value.
+    assert_eq!(outcome.mutated, enabled);
+    assert_eq!(transaction::retained_for_test(), (true, false, true));
+    assert!(transaction::MutationPermit::acquire().is_none());
+    assert_eq!(
+        run.observe(),
+        AutostartObservation::Unavailable(AutostartFailure::Unavailable)
+    );
+    // This injected failure withheld CloseHandle, so the exact original HANDLE
+    // remains valid. Actually close it once before native readback/scratch cleanup.
+    // Production does not expose this cleanup or reset its permanent Faulted gate.
+    assert!(transaction::release_retained_for_test());
+    assert_eq!(transaction::retained_for_test(), (true, false, false));
+    assert!(transaction::MutationPermit::acquire().is_none());
+    let key = run.open_key(false, false).unwrap().unwrap();
+    let actual = RunAtLogin::read_key(&key);
+    key.close().unwrap();
+    let expected = if enabled {
+        AutostartObservation::Command(run.expected_command().into())
+    } else {
+        AutostartObservation::Absent
+    };
+    assert_eq!(actual, expected);
+}
