+fn assert_removed(
+    files: &ControlledContentFiles,
+    entry: &fc_bootstrap::backend::MediaEntry,
+    reserved_bytes: u64,
+) {
+    assert_eq!(entry.state, MediaState::Removed, "{entry:?}");
+    assert_eq!(entry.refs, 0, "{entry:?}");
