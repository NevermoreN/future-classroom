+fn mapped_path(module: HMODULE) -> Result<ModulePath> {
+    let mut path = ModulePath {
+        units: [0; PATH_UNITS],
+        len: 0,
+    };
+    // SAFETY: production pins the exact module before this query; tests borrow
+    // the statically imported module. Its image base stays valid across the call.
+    // The process pseudo handle is borrowed. K32 is exported by Kernel32 on Win7+
+    // and this query creates no mapping or file/process handle.
+    let len =
+        unsafe { K32GetMappedFileNameW(GetCurrentProcess(), module.0, &mut path.units) } as usize;
+    if len == 0 {
+        return Err(Error::from_thread());
+    }
+    if len >= PATH_UNITS {
+        return Err(Error::from_hresult(ERROR_INSUFFICIENT_BUFFER.to_hresult()));
+    }
+    if path.units[..len].contains(&0) || path.units[len] != 0 {
+        return Err(Error::from_hresult(E_ACCESSDENIED));
+    }
+    path.len = len;
+    Ok(path)
+}
+
+fn nt_system_path(dos: &ModulePath) -> Result<ModulePath> {
+    let drive = [dos.units[0], dos.units[1], 0];
+    let mut mappings = [0u16; PATH_UNITS];
+    // SAFETY: only the drive from the already validated OS system path is
+    // queried, by its exact two-character name. No enumeration or mutation.
+    let len = unsafe { QueryDosDeviceW(PCWSTR(drive.as_ptr()), Some(&mut mappings)) } as usize;
+    if len == 0 {
+        return Err(Error::from_thread());
+    }
+    if len >= PATH_UNITS {
+        return Err(Error::from_hresult(ERROR_INSUFFICIENT_BUFFER.to_hresult()));
+    }
+    nt_path_from_current_mapping(dos.as_slice(), &mappings[..len])
+}
+
+fn nt_path_from_current_mapping(dos: &[u16], mappings: &[u16]) -> Result<ModulePath> {
+    // QueryDosDevice returns MULTI_SZ: only the first string is CURRENT. Never
+    // authorize a match against an undeleted historical mapping from later rows.
+    if mappings.len() < 2
+        || mappings.len() >= PATH_UNITS
+        || mappings[mappings.len() - 2..] != [0, 0]
+    {
+        return Err(Error::from_hresult(E_ACCESSDENIED));
+    }
+    let end = mappings
+        .iter()
+        .position(|&unit| unit == 0)
+        .filter(|&end| end > 0)
+        .ok_or_else(|| Error::from_hresult(E_ACCESSDENIED))?;
+    let current = &mappings[..end];
+    let device_prefix = [
+        b'\\' as u16,
+        b'D' as u16,
+        b'e' as u16,
+        b'v' as u16,
+        b'i' as u16,
+        b'c' as u16,
+        b'e' as u16,
+        b'\\' as u16,
+    ];
+    if dos.len() < 3
+        || dos[1] != b':' as u16
+        || dos[2] != b'\\' as u16
+        || dos.contains(&0)
+        || current.len() <= device_prefix.len()
+        || !same_system_path(&device_prefix, &current[..device_prefix.len()])
+        || current.last() == Some(&(b'\\' as u16))
+    {
+        return Err(Error::from_hresult(E_ACCESSDENIED));
+    }
+    let suffix = &dos[2..];
+    let len = current
+        .len()
+        .checked_add(suffix.len())
+        .filter(|&len| len < PATH_UNITS)
+        .ok_or_else(|| Error::from_hresult(ERROR_INSUFFICIENT_BUFFER.to_hresult()))?;
+    let mut path = ModulePath {
+        units: [0; PATH_UNITS],
+        len,
+    };
+    path.units[..current.len()].copy_from_slice(current);
+    path.units[current.len()..len].copy_from_slice(suffix);
     Ok(path)
 }
 
