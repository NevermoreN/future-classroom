+    data.insert(PORT, port.into()).unwrap();
+    data.insert(CERTIFICATE, "ab".repeat(20)).unwrap();
+    data
+}
+fn edit() -> Editor {
+    let mut e = Editor::new(owner(1));
+    e.loaded(base(0));
+    e
