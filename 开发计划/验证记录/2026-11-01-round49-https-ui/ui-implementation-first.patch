+#[test]
+fn pending_page_allows_only_cancel_wait_and_lock_with_readonly_fields() {
+    let e = edit();
+    let view = e.view(owner(1), "正在保存", true);
+    view.validate().unwrap();
+    assert!(!view.busy);
+    assert!(view.fields.iter().all(|f| f.kind == FieldKind::ReadOnly));
+    assert!(
