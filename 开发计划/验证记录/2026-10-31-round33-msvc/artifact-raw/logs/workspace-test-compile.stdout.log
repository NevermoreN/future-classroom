\";"},{"highlight_end":36,"highlight_start":1,"text":"    /// MMX (MultiMedia eXtensions)"},{"highlight_end":26,"highlight_start":1,"text":"    @FEATURE: sse: \"sse\";"},{"highlight_end":40,"highlight_start":1,"text":"    /// SSE (Streaming SIMD Extensions)"},{"highlight_end":28,"highlight_start":1,"text":"    @FEATURE: sse2: \"sse2\";"},{"highlight_end":43,"highlight_start":1,"text":"    /// SSE2 (Streaming SIMD Extensions 2)"},{"highlight_end":28,"highlight_start":1,"text":"    @FEATURE: sse3: \"sse3\";"},{"highlight_end":43,"highlight_start":1,"text":"    /// SSE3 (Streaming SIMD Extensions 3)"},{"highlight_end":30,"highlight_start":1,"text":"    @FEATURE: ssse3: \"ssse3\";"},{"highlight_end":57,"highlight_start":1,"text":"    /// SSSE3 (Supplemental Streaming SIMD Extensions 3)"},{"highlight_end":32,"highlight_start":1,"text":"    @FEATURE: sse4_1: \"sse4.1\";"},{"highlight_end":47,"highlight_start":1,"text":"    /// SSE4.1 (Streaming SIMD Extensions 4.1)"},{"highlight_end":32,"highlight_start":1,"text":"    @FEATURE: sse4_2: \"sse4.2\";"},{"highlight_end":47,"highlight_start":1,"text":"    /// SSE4.2 (Streaming SIMD Extensions 4.2)"},{"highlight_end":30,"highlight_start":1,"text":"    @FEATURE: sse4a: \"sse4a\";"},{"highlight_end":45,"highlight_start":1,"text":"    /// SSE4a (Streaming SIMD Extensions 4a)"},{"highlight_end":26,"highlight_start":1,"text":"    @FEATURE: sha: \"sha\";"},{"highlight_end":12,"highlight_start":1,"text":"    /// SHA"},{"highlight_end":26,"highlight_start":1,"text":"    @FEATURE: avx: \"avx\";"},{"highlight_end":41,"highlight_start":1,"text":"    /// AVX (Advanced Vector Extensions)"},{"highlight_end":28,"highlight_start":1,"text":"    @FEATURE: avx2: \"avx2\";"},{"highlight_end":44,"highlight_start":1,"text":"    /// AVX2 (Advanced Vector Extensions 2)"},{"highlight_end":35,"highlight_start":1,"text":"    @FEATURE: avx512f: \"avx512f\" ;"},{"highlight_end":31,"highlight_start":1,"text":"    /// AVX-512 F (Foundation)"},{"highlight_end":37,"highlight_start":1,"text":"    @FEATURE: avx512cd: \"avx512cd\" ;"},{"highlight_end":53,"highlight_start":1,"text":"    /// AVX-512 CD (Conflict Detection Instructions)"},{"highlight_end":36,"highlight_start":1,"text":"    @FEATURE: avx512er: \"avx512er\";"},{"highlight_end":62,"highlight_start":1,"text":"    /// AVX-512 ER (Expo nential and Reciprocal Instructions)"},{"highlight_end":36,"highlight_start":1,"text":"    @FEATURE: avx512pf: \"avx512pf\";"},{"highlight_end":43,"highlight_start":1,"text":"    /// AVX-512 PF (Prefetch Instructions)"},{"highlight_end":36,"highlight_start":1,"text":"    @FEATURE: avx512bw: \"avx512bw\";"},{"highlight_end":48,"highlight_start":1,"text":"    /// AVX-512 BW (Byte and Word Instructions)"},{"highlight_end":36,"highlight_start":1,"text":"    @FEATURE: avx512dq: \"avx512dq\";"},{"highlight_end":45,"highlight_start":1,"text":"    /// AVX-512 DQ (Doubleword and Quadword)"},{"highlight_end":36,"highlight_start":1,"text":"    @FEATURE: avx512vl: \"avx512vl\";"},{"highlight_end":46,"highlight_start":1,"text":"    /// AVX-512 VL (Vector Length Extensions)"},{"highlight_end":40,"highlight_start":1,"text":"    @FEATURE: avx512ifma: \"avx512ifma\";"},{"highlight_end":50,"highlight_start":1,"text":"    /// AVX-512 IFMA (Integer Fused Multiply Add)"},{"highlight_end":40,"highlight_start":1,"text":"    @FEATURE: avx512vbmi: \"avx512vbmi\";"},{"highlight_end":61,"highlight_start":1,"text":"    /// AVX-512 VBMI (Vector Byte Manipulation Instructions)"},{"highlight_end":50,"highlight_start":1,"text":"    @FEATURE: avx512vpopcntdq: \"avx512vpopcntdq\";"},{"highlight_end":66,"highlight_start":1,"text":"    /// AVX-512 VPOPCNTDQ (Vector Population Count Doubleword and"},{"highlight_end":18,"highlight_start":1,"text":"    /// Quadword)"},{"highlight_end":42,"highlight_start":1,"text":"    @FEATURE: avx512vbmi2: \"avx512vbmi2\";"},{"highlight_end":76,"highlight_start":1,"text":"    /// AVX-512 VBMI2 (Additional byte, word, dword and qword capa