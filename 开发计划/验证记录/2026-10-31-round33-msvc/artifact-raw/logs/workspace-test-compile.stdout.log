t":1,"text":"    /// being tested for. The feature names supported are the lowercase versions of"},{"highlight_end":66,"highlight_start":1,"text":"    /// the ones defined by Intel in [their documentation][docs]."},{"highlight_end":8,"highlight_start":1,"text":"    ///"},{"highlight_end":31,"highlight_start":1,"text":"    /// ## Supported arguments"},{"highlight_end":8,"highlight_start":1,"text":"    ///"},{"highlight_end":85,"highlight_start":1,"text":"    /// This macro supports the same names that `#[target_feature]` supports. Unlike"},{"highlight_end":82,"highlight_start":1,"text":"    /// `#[target_feature]`, however, this macro does not support names separated"},{"highlight_end":81,"highlight_start":1,"text":"    /// with a comma. Instead testing for multiple features must be done through"},{"highlight_end":44,"highlight_start":1,"text":"    /// separate macro invocations for now."},{"highlight_end":8,"highlight_start":1,"text":"    ///"},{"highlight_end":33,"highlight_start":1,"text":"    /// Supported arguments are:"},{"highlight_end":8,"highlight_start":1,"text":"    ///"},{"highlight_end":18,"highlight_start":1,"text":"    /// * `\"aes\"`"},{"highlight_end":24,"highlight_start":1,"text":"    /// * `\"pclmulqdq\"`"},{"highlight_end":21,"highlight_start":1,"text":"    /// * `\"rdrand\"`"},{"highlight_end":21,"highlight_start":1,"text":"    /// * `\"rdseed\"`"},{"highlight_end":18,"highlight_start":1,"text":"    /// * `\"tsc\"`"},{"highlight_end":18,"highlight_start":1,"text":"    /// * `\"mmx\"`"},{"highlight_end":18,"highlight_start":1,"text":"    /// * `\"sse\"`"},{"highlight_end":19,"highlight_start":1,"text":"    /// * `\"sse2\"`"},{"highlight_end":19,"highlight_start":1,"text":"    /// * `\"sse3\"`"},{"highlight_end":20,"highlight_start":1,"text":"    /// * `\"ssse3\"`"},{"highlight_end":21,"highlight_start":1,"text":"    /// * `\"sse4.1\"`"},{"highlight_end":21,"highlight_start":1,"text":"    /// * `\"sse4.2\"`"},{"highlight_end":20,"highlight_start":1