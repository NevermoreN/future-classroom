+name: Windows 7 MSVC candidate COMPILE_ONLY
+
+# Tier3 target: fixed nightly + same-toolchain rust-src; no prebuilt target install.
+# Original135/105minute job/build budgets retained; no speculative extension.
+# Deliberately manual: this builds test executables; it does not run or certify
+# Windows 7/10/11, deploy a product, publish a release, or install a user machine.
+on:
+  workflow_dispatch:
+    inputs:
+      source_sha:
+        description: Expected full 40-character source Git SHA; reject a moved dispatch ref
+        required: true
+        type: string
+
+permissions:
+  contents: read
+
+concurrency:
+  group: windows-win7-msvc-${{ github.ref }}
+  cancel-in-progress: false
+
+jobs:
+  compile-win7-i686:
+    if: github.repository == 'NevermoreN/future-classroom'
+    runs-on: windows-2022
+    timeout-minutes: 135
+    defaults:
+      run:
+        shell: pwsh
+    env:
+      FC_MSVC_EXPECTED_SHA: ${{ inputs.source_sha }}
+      FC_MSVC_DISPATCH_SHA: ${{ github.sha }}
+    steps:
+      - name: Create this run's bounded evidence directory
+        run: |
+          $ErrorActionPreference = 'Stop'
+          if ($env:RUNNER_ENVIRONMENT -ne 'github-hosted') { throw 'Hosted runner required.' }
+          $env:FC_MSVC_RUN_ROOT = Join-Path $env:RUNNER_TEMP "future-classroom-win7-msvc-$env:GITHUB_RUN_ID-$env:GITHUB_RUN_ATTEMPT"
+          "FC_MSVC_RUN_ROOT=$env:FC_MSVC_RUN_ROOT" | Out-File -FilePath $env:GITHUB_ENV -Encoding utf8 -Append
+          if (Test-Path -LiteralPath $env:FC_MSVC_RUN_ROOT) { throw 'Run directory already exists; preserve earlier evidence.' }
+          New-Item -ItemType Directory -Path "$env:FC_MSVC_RUN_ROOT\artifact\logs" | Out-Null
+          [IO.File]::WriteAllText("$env:FC_MSVC_RUN_ROOT\.owner", 'future-classroom-win7-msvc-ci/v1')
+          [ordered]@{
+            stage = 'before_checkout'; expected_source_sha = $env:FC_MSVC_EXPECTED_SHA
+            dispatch_source_sha = $env:FC_MSVC_DISPATCH_SHA
+            workflow_sha = $env:GITHUB_WORKFLOW_SHA; repository = $env:GITHUB_REPOSITORY
+            run_id = $env:GITHUB_RUN_ID; run_attempt = $env:GITHUB_RUN_ATTEMPT
+            runner_image = $env:ImageOS; runner_image_version = $env:ImageVersion
+            role = 'win7-msvc-candidate-compilation-only'; windows_runtime_tests = 'NOT_RUN'
+          } | ConvertTo-Json | Set-Content -LiteralPath "$env:FC_MSVC_RUN_ROOT\artifact\bootstrap.json" -Encoding utf8NoBOM
+          if ($env:FC_MSVC_EXPECTED_SHA -notmatch '\A[0-9a-fA-F]{40}\z' -or
+              $env:FC_MSVC_DISPATCH_SHA -notmatch '\A[0-9a-fA-F]{40}\z') {
+            throw 'source_sha and dispatch SHA must each be exactly 40 hexadecimal characters.'
+          }
+          if ($env:FC_MSVC_EXPECTED_SHA -ine $env:FC_MSVC_DISPATCH_SHA) {
+            throw 'Dispatch ref moved or differs from requested source_sha; no checkout/build admitted.'
+          }
+
+      # Official action release v7.0.1, full immutable commit; no persisted PAT.
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          ref: ${{ github.sha }}
+          fetch-depth: 1
+          persist-credentials: false
+
+      - name: Compile Win7 MSVC candidate with rebuilt std/test; never execute
+        timeout-minutes: 105
+        run: |
