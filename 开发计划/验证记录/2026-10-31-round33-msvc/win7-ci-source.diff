+
+      - name: Clean only this ephemeral run's build and tool roots
+        if: always()
+        timeout-minutes: 10
+        run: |
+          $ErrorActionPreference = 'Stop'
+          if (Test-Path -LiteralPath './scripts/windows-msvc-ci.ps1') {
+            ./scripts/windows-msvc-ci.ps1 -Baseline Win7 -Mode Cleanup -RunRoot $env:FC_MSVC_RUN_ROOT
+          } else {
+            # Checkout never supplied the script: no compiler was started.
+            @{ status = 'BUILD_NOT_STARTED'; reason = 'checkout did not provide cleanup script' } |
+              ConvertTo-Json | Set-Content -LiteralPath "$env:FC_MSVC_RUN_ROOT\artifact\cleanup.json" -Encoding utf8NoBOM
+          }
+
+      # Official v7.0.2. Original logs/partial products survive ordinary failures.
+      # Job/VM termination can still interrupt upload; no artifact is presumed.
+      - name: Upload original logs, metadata and compiled test executables
+        if: always()
+        timeout-minutes: 15
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
+        with:
+          name: future-classroom-win7-msvc-i686-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}
+          path: ${{ env.FC_MSVC_RUN_ROOT }}\artifact
+          if-no-files-found: error
+          compression-level: 1
+          retention-days: 14
+          overwrite: false
+
+      # The uploaded evidence is intentionally retained until GitHub disposes
+      # this job's fresh hosted VM. No user's Windows/NAS directories are touched.
