+/// Common composition boundary for normal/manual, logon and application-repair
+/// entry. Only unit success proves the caller has actually returned all physical
+/// owners. A body error or unwind retains the ORIGINAL lease in the existing
+/// bounded native ledger until process exit; logical return is never release.
+///
+/// No `Ok(T)` can transfer a live owner out through this boundary. The trusted
+/// caller still must join workers/native resources before returning `Ok(())`.
+pub fn with_startup_lease<E>(
+    identity: &InstallIdentity,
+    body: impl FnOnce() -> std::result::Result<(), E>,
+) -> Result<std::result::Result<(), E>> {
+    let lease = LifecycleGate::acquire_startup(identity)?;
+    let mut hold = StartupHold {
+        lease: std::mem::ManuallyDrop::new(lease),
+        armed: true,
+    };
+    match body() {
+        Ok(()) => {
+            let mut lease = hold.take();
+            lease.try_release()?;
+            Ok(Ok(()))
+        }
+        Err(error) => Ok(Err(error)), // armed guard retains, does not close
+    }
+}
+struct StartupHold {
+    lease: std::mem::ManuallyDrop<StartupLease>,
+    armed: bool,
+}
+impl StartupHold {
+    fn take(&mut self) -> StartupLease {
+        assert!(self.armed);
+        self.armed = false;
+        // SAFETY: this unique guard owns the initialized lease; armed is cleared
+        // before exactly one move. Its Drop cannot take or close it a second time.
+        unsafe { std::mem::ManuallyDrop::take(&mut self.lease) }
+    }
+}
+impl Drop for StartupHold {
+    fn drop(&mut self) {
+        if self.armed {
+            let mut lease = self.take();
+            lease.resources.retain_until_exit();
+            // The ordinary destructor now owns no native handle. Original claim
+            // and raw capabilities remain in the fixed process-retention ledger.
+        }
     }
 }
 
