{
  "scope": "Release build inputs; documentation and separate cfg(test) flow test module excluded; build only, not formal MSVC/platform certification",
  "target": "i686-win7-windows-gnu",
  "command": [
    "cargo",
    "+nightly-2026-10-29",
    "build",
    "-p",
    "fc-bootstrap",
    "--release",
    "--target",
    "i686-win7-windows-gnu",
    "--locked",
    "--message-format=json",
    "-Z",
    "build-std=std,panic_unwind",
    "-Z",
    "unstable-options"
  ],
  "crossCompilerEnvironment": {
    "CC_i686_win7_windows_gnu": "i686-w64-mingw32-gcc",
    "AR_i686_win7_windows_gnu": "i686-w64-mingw32-ar",
    "CARGO_BUILD_JOBS": "2"
  },
  "inputsUnchangedDuringBuild": false,
  "exitCode": 0,
  "changedInputs": [
    "crates/fc-bootstrap/src/application.rs"
  ]
}
